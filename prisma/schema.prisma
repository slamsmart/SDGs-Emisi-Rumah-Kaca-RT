generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WARGA
  ADMIN_RT
  ADMIN_RW
}

enum ReportStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  PUSH
}

enum FactorUnit {
  PASSENGER_KM
  VEHICLE_KM
}

model Village {
  id            String          @id @default(cuid())
  name          String
  rws           Rw[]
  users         User[]
  rewards       Reward[]
  transportModes TransportMode[]
  notifications Notification[]
  createdAt     DateTime        @default(now())
}

model Rw {
  id        String   @id @default(cuid())
  number    String
  villageId String
  village   Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  rts       Rt[]
  users     User[]

  @@unique([villageId, number])
}

model Rt {
  id     String @id @default(cuid())
  number String
  rwId   String
  rw     Rw     @relation(fields: [rwId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([rwId, number])
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  email               String               @unique
  passwordHash        String
  role                UserRole
  villageId           String
  rwId                String?
  rtId                String?
  totalPoints         Int                  @default(0)
  currentStreak       Int                  @default(0)
  lastReportDate      DateTime?
  createdAt           DateTime             @default(now())
  village             Village              @relation(fields: [villageId], references: [id], onDelete: Cascade)
  rw                  Rw?                  @relation(fields: [rwId], references: [id], onDelete: SetNull)
  rt                  Rt?                  @relation(fields: [rtId], references: [id], onDelete: SetNull)
  reports             TransportReport[]
  reviewedReports     TransportReport[]    @relation("ReviewActor")
  pointsLedger        PointsLedger[]
  achievementAwards   AchievementAward[]
  notifications       Notification[]
  redemptions         RewardRedemption[]
  processedRedemptions RewardRedemption[]  @relation("RewardProcessor")
  pushSubscriptions   PushSubscription[]
  auditLogs           AuditLog[]           @relation("AuditActor")
}

model TransportMode {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  category         String
  defaultOccupancy Float?
  sortOrder        Int
  isActive         Boolean            @default(true)
  villageId        String?
  village          Village?           @relation(fields: [villageId], references: [id], onDelete: SetNull)
  emissionFactors  EmissionFactor[]
  actualReports    TransportReport[]  @relation("ActualMode")
  baselineReports  TransportReport[]  @relation("BaselineMode")
  createdAt        DateTime           @default(now())
}

model EmissionFactor {
  id              String        @id @default(cuid())
  transportModeId String
  unit            FactorUnit
  kgCo2ePerKm     Float
  isActive        Boolean       @default(true)
  sourceNote      String?
  createdAt       DateTime      @default(now())
  transportMode   TransportMode @relation(fields: [transportModeId], references: [id], onDelete: Cascade)

  @@index([transportModeId, isActive])
}

model TransportReport {
  id                 String        @id @default(cuid())
  userId             String
  reportDate         DateTime
  distanceKm         Float
  trips              Int
  isRoundTrip        Boolean
  occupancy          Float?
  actualModeId       String
  baselineModeId     String
  actualEmissionKg   Float
  baselineEmissionKg Float
  avoidedEmissionKg  Float
  pointsAwarded      Int           @default(0)
  anomalyReason      String?
  status             ReportStatus  @default(APPROVED)
  createdAt          DateTime      @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  actualMode         TransportMode @relation("ActualMode", fields: [actualModeId], references: [id])
  baselineMode       TransportMode @relation("BaselineMode", fields: [baselineModeId], references: [id])
  reviewedBy         User?         @relation("ReviewActor", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, reportDate])
  @@index([status, reportDate])
}

model PointsLedger {
  id          String   @id @default(cuid())
  userId      String
  delta       Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AchievementAward {
  id          String   @id @default(cuid())
  userId      String
  code        String
  title       String
  description String
  awardedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

model Reward {
  id          String             @id @default(cuid())
  villageId   String
  title       String
  description String
  costPoints  Int
  stock       Int
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  village     Village            @relation(fields: [villageId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]
}

model RewardRedemption {
  id            String                 @id @default(cuid())
  userId        String
  rewardId      String
  costPoints    Int
  status        RewardRedemptionStatus @default(PENDING)
  notes         String?
  processedById String?
  createdAt     DateTime               @default(now())
  processedAt   DateTime?
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward        Reward                 @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  processedBy   User?                  @relation("RewardProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  villageId String
  title     String
  body      String
  href      String?
  isRead    Boolean             @default(false)
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  village   Village             @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  detail     String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
}
